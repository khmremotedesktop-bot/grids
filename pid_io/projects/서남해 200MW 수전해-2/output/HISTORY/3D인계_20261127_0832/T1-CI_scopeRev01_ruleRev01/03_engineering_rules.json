     "result_key": "spare"
    },
    {
     "step_id": "S3",
     "operation": "count(io) = |{ row : row.io = io }| (스페어 포함), 통신 포트 = Serial/Comm 행 (C04 ON이면 A/B 2점)",
     "result_key": "CI-IO-*"
    }
