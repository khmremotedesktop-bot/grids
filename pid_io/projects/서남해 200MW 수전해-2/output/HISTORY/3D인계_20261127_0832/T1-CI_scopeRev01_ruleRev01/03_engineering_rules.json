  {
   "rule_id": "R-TR",
   "title": "사다리 트레이",
   "rule_kind": "QUANTITY",
   "scope_ids": [
    "CI-TR-SIG-300",
    "CI-TR-SIG-600",
    "CI-TR-SIG-900",
    "CI-TR-COM-300"
   ],
   "input_field_ids": [
    "F-T01",
    "F-T02",
    "F-T03",
    "F-T04",
    "F-T05",
    "F-T06",
    "F-PLOT-SCALE",
    "F-ROOM-XY",
    "F-RACK"
   ],
   "preconditions": "추출 완료, 체크리스트·STEP 6~9 설정 적용, PLOT 축척·제어실 확인",
   "steps": [
    {
     "step_id": "S1",
     "operation": "간선 경로를 격자 변으로 나눠 같은 케이블 묶음 · 같은 종류(랙/AG/UG)가 이어지는 직선 = 구간",
     "result_key": "segments"
    },
    {
     "step_id": "S2",
     "operation": "구간 × 트레이 구분(신호/IS/통신): A = Σ π/4 · OD² (OD = 사양별 외경표)",
     "result_key": "area"
    },
    {
     "step_id": "S3",
     "operation": "W = 가장 작은 폭: A ≤ W × H × Fill, 가장 넓은 폭으로도 넘치면 단 n = ceil(A / (Wmax × H × Fill))",
     "result_key": "width"
    },
    {
     "step_id": "S4",
     "operation": "length(cls, W) = Σ 구간 길이 × 단 수; 물량 = × (1 + tray_fit) → margin",
     "result_key": "CI-TR-*"
    }
   ],
   "outputs": [
    {
