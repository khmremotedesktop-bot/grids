    {
     "step_id": "S2",
     "operation": "경로 = 제어실에서 1 m 격자 Dijkstra (랙 1/m, 랙 밖 '랙 우선도'/m, 장애물 통과 불가)",
     "result_key": "route"
    },
    {
     "step_id": "S3",
     "operation": "L = roundup((랙 m + 랙 밖 m + 오르내림 높이) × (1 + 여유율), 올림)",
     "result_key": "length"
    },
    {
     "step_id": "S4",
     "operation": "Σ L by spec",
     "result_key": "CI-CB-MU-*"
    }
